# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Server
PORT=4000
NODE_ENV=development

# Database (use postgres:// for Postgres, file:// for SQLite)
DATABASE_URL="file:./dev.db"

# JWT Authentication (⚠️  SECURITY: Use at least 32 characters in production)
JWT_SECRET="your-super-secret-key-change-me-in-production-use-at-least-32-chars"

# Blockchain RPC
CHAIN_RPC_URL="http://127.0.0.1:8545"
SEPOLIA_RPC="https://sepolia.infura.io/v3/your-infura-key"
CHAIN_ID=1337

# Wallet/Deployment Private Key (⚠️  SECURITY: Never commit actual keys to git)
PRIVATE_KEY="0xabc123def456..."
TENANT_PRIVATE_KEY="0xdef456abc789..."

# Email Configuration
EMAIL_SENDER="notifications@example.com"

# External Listings Feed (Optional)
REPLIERS_API_URL="https://api.repliers.com/v1/listings"
REPLIERS_API_KEY="your-api-key-here"

# Logging
LOG_LEVEL=debug
